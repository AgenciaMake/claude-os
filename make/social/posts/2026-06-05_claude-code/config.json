48px;line-height:1;margin-bottom:12px;'>📱</div><div style='font-size:28px;font-weight:700;color:var(--white);line-height:1.2;margin-bottom:6px;'>Social Media</div><div style='font-size:24px;font-weight:400;color:rgba(255,255,255,0.6);line-height:1.3;'>Criação de posts e análises rotineiras</div></div><div style='background:rgba(255,255,255,0.06);border-radius:14px;padding:22px 20px;'><div style='font-size:48px;line-height:1;margin-bottom:12px;'>🚀</div><div style='font-size:28px;font-weight:700;color:var(--white);line-height:1.2;margin-bottom:6px;'>Produtos</div><div style='font-size:24px;font-weight:400;color:rgba(255,255,255,0.6);line-height:1.3;'>Mais autonomia para criar e resolver demandas internas</div></div></div></div>"
