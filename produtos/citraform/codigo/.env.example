# CitraForm — template de variáveis de ambiente
# Copiar pra .env.local e preencher os valores reais.
# .env.local NÃO vai pro GitHub (está no .gitignore).

# ============== Supabase ==============
# Pegue em Project Settings > API no Supabase Dashboard do projeto CitraForm.
# Projeto ainda não criado — placeholders por enquanto.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (anon public key)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (service_role key — só backend, nunca exponha no client!)

# ============== Resend ==============
# Pegue em https://resend.com/api-keys
RESEND_API_KEY=re_...

# ============== Admin ==============
SUPER_ADMIN_EMAIL=your-admin-email@example.com
